rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /familias/{familyId}/screenshots/{fileName} {
      allow read: if request.auth != null
        && request.auth.token.familyId == familyId
        && (request.auth.token.familyRole == 'owner' || request.auth.token.familyRole == 'member');

      allow write: if request.auth != null
        && request.auth.token.familyId == familyId
        && request.auth.token.familyRole == 'owner'
        && fileName.matches('^[0-9]+\\.jpg$')
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');

      allow delete: if request.auth != null
        && request.auth.token.familyId == familyId
        && request.auth.token.familyRole == 'owner'
        && fileName.matches('^[0-9]+\\.jpg$');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
